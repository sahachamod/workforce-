[Unit]
Description=Roster Service - Shift Management
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/roster-service
Environment="PATH=/var/www/backend/roster-service/venv/bin"
ExecStart=/var/www/backend/roster-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8004 --workers 2
Restart=always
StandardOutput=append:/var/log/services/roster-service.log
StandardError=append:/var/log/services/roster-service.log

[Install]
WantedBy=multi-user.target
