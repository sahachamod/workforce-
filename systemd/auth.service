[Unit]
Description=Auth Service - Authentication & Authorization
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/auth-service
Environment="PATH=/var/www/backend/auth-service/venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/var/www/backend/auth-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8001 --workers 2
Restart=always
RestartSec=5
StandardOutput=append:/var/log/services/auth-service.log
StandardError=append:/var/log/services/auth-service.log

[Install]
WantedBy=multi-user.target
