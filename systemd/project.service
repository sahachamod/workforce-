[Unit]
Description=Project Management Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/project-service
Environment="PATH=/var/www/backend/project-service/venv/bin"
ExecStart=/var/www/backend/project-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8005 --workers 2
Restart=always
StandardOutput=append:/var/log/services/project-service.log
StandardError=append:/var/log/services/project-service.log

[Install]
WantedBy=multi-user.target
