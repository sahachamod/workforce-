[Unit]
Description=Leave Management Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/leave-service
Environment="PATH=/var/www/backend/leave-service/venv/bin"
ExecStart=/var/www/backend/leave-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8003 --workers 2
Restart=always
StandardOutput=append:/var/log/services/leave-service.log
StandardError=append:/var/log/services/leave-service.log

[Install]
WantedBy=multi-user.target
