[Unit]
Description=User Service - Employee Management
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/user-service
Environment="PATH=/var/www/backend/user-service/venv/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/var/www/backend/user-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8002 --workers 2
Restart=always
RestartSec=5
StandardOutput=append:/var/log/services/user-service.log
StandardError=append:/var/log/services/user-service.log

[Install]
WantedBy=multi-user.target
