[Unit]
Description=Analytics Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/analytics-service
Environment="PATH=/var/www/backend/analytics-service/venv/bin"
ExecStart=/var/www/backend/analytics-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8007 --workers 2
Restart=always
StandardOutput=append:/var/log/services/analytics-service.log
StandardError=append:/var/log/services/analytics-service.log

[Install]
WantedBy=multi-user.target
