[Unit]
Description=Notification Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/backend/notification-service
Environment="PATH=/var/www/backend/notification-service/venv/bin"
ExecStart=/var/www/backend/notification-service/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8008 --workers 2
Restart=always
StandardOutput=append:/var/log/services/notification-service.log
StandardError=append:/var/log/services/notification-service.log

[Install]
WantedBy=multi-user.target
